LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Active file/view tasks; phase 2 has an independent request pool per view.
LLM_TASK_CONCURRENCY=10
# Requests within EACH active view, not a job-wide HTTP cap.
LLM_MAX_CONCURRENCY=5

# Per invocation request budget, including format/transport retries
ENTITY_MAX_CALLS=24
# Fixed-label second-stage expert/arbiter targets per request (1-12)
LABEL_LENGTH_REVIEW_BATCH_SIZE=6

# Legacy length-arbitration only; NOT the fixed-label stage-two policy.
# economy: verifier then conflict-only arbiter; full: previous multi-role chain
LENGTH_REVIEW_MODE=economy
# Legacy role budget; not a cost cap for the fixed-label stage-two agents.
# Includes length-role format/transport retries; excludes grid/master requests
LENGTH_REVIEW_MAX_CALLS=2
